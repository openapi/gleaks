[Desktop Entry]
Type=Application
Name=GLeaks
GenericName=Data Exposure Monitor
Comment=Discover and manage personal data exposures
Exec=gleaks %f
Icon=io.github.openapi.GLeaks
Terminal=false
Categories=GNOME;GTK;Utility;Security;
